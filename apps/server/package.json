{
  "name": "t3",
  "version": "0.0.24",
  "description": "Self-hosted GUI for Claude Code and other coding agents. Web + PWA + desktop. Drive long-running agent sessions from your phone or tablet over Tailscale.",
  "license": "MIT",
  "author": "Ping Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/pingdotgg/t3code",
    "directory": "apps/server"
  },
  "homepage": "https://github.com/pingdotgg/t3code#readme",
  "bugs": {
    "url": "https://github.com/pingdotgg/t3code/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent",
    "ai",
    "anthropic",
    "coding-assistant",
    "pwa",
    "cli",
    "tailscale",
    "mobile",
    "self-hosted"
  ],
  "bin": {
    "t3": "./dist/bin.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "node --watch src/bin.ts",
    "build": "node scripts/cli.ts build",
    "build:bundle": "tsdown",
    "start": "node dist/bin.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.111",
    "@effect/platform-bun": "catalog:",
    "@effect/platform-node": "catalog:",
    "@effect/platform-node-shared": "catalog:",
    "@effect/sql-sqlite-bun": "catalog:",
    "@opencode-ai/sdk": "^1.3.15",
    "@pierre/diffs": "catalog:",
    "effect": "catalog:",
    "node-pty": "^1.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:",
    "@effect/vitest": "catalog:",
    "@t3tools/contracts": "workspace:*",
    "@t3tools/shared": "workspace:*",
    "@t3tools/tailscale": "workspace:*",
    "@t3tools/web": "workspace:*",
    "@types/bun": "catalog:",
    "@types/node": "catalog:",
    "@types/web-push": "^3.6.4",
    "effect-acp": "workspace:*",
    "effect-codex-app-server": "workspace:*",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": "^22.16 || ^23.11 || >=24.10"
  }
}
